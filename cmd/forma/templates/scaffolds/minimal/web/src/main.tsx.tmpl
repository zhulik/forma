import { FormaHost, builtinRegistry, mergeRegistry, mountFormaHost } from "./host";
import { customRegistry } from "./registry.custom";
import { registry as generatedRegistry } from "./registry.gen";

const effectiveRegistry = mergeRegistry(
  builtinRegistry,
  generatedRegistry,
  customRegistry,
);

// P3c replaces null with the GopherJS-driven tree root.
const tree = null;

mountFormaHost(
  "{{ .Mount }}",
  <FormaHost registry={effectiveRegistry} tree={tree} />,
);
