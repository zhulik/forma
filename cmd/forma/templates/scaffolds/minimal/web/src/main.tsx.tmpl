import {
  FormaBridgeHost,
  builtinRegistry,
  createFormaBridge,
  mergeRegistry,
  mountFormaHost,
  registerFormaHost,
} from "./host";
import { customRegistry } from "./registry.custom";
import { registry as generatedRegistry } from "./registry.gen";

const effectiveRegistry = mergeRegistry(
  builtinRegistry,
  generatedRegistry,
  customRegistry,
);

// Register before any GopherJS UIMount call (load the Go bundle after this module).
const bridge = createFormaBridge();
registerFormaHost(bridge);

mountFormaHost(
  "{{ .Mount }}",
  <FormaBridgeHost registry={effectiveRegistry} bridge={bridge} />,
);
