import {
  FormaBridgeHost,
  builtinRegistry,
  createFormaBridge,
  mergeRegistry,
  mountFormaHost,
  registerFormaHost,
} from "./host";
import { customRegistry } from "./registry.custom";
import { registry as generatedRegistry } from "./registry.gen";

const effectiveRegistry = mergeRegistry(
  builtinRegistry,
  generatedRegistry,
  customRegistry,
);

// Register before any GopherJS UIMount call (load the Go bundle after this module).
const bridge = createFormaBridge();
registerFormaHost(bridge);

mountFormaHost(
  "{{ .Mount }}",
  <FormaBridgeHost registry={effectiveRegistry} bridge={bridge} />,
);

// P3c contract: GopherJS writes web/public/app.js (served as /app.js).
// Host must be registered before this classic script runs UIMount.
const goBundle = document.createElement("script");
goBundle.src = "/app.js";
goBundle.async = false;
document.body.appendChild(goBundle);
